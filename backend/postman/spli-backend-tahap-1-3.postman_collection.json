{
  "info": {
    "name": "SPLI Backend — Tahap 1–3",
    "_postman_id": "spli-backend-tahap-1-3",
    "description": "REST API E-Learning Sekolah Pelaut Indonesia (baseUrl/api/v1). Tahap 1: fondasi. Tahap 2: auth + 2FA + session. Tahap 3: users, cohorts, enrollments, impor .xlsx.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [""],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "00-operational",
      "item": [
        {
          "name": "GET health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        },
        {
          "name": "GET ready",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/ready" }
        }
      ]
    },
    {
      "name": "10-auth",
      "item": [
        {
          "name": "POST register Taruna",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"taruna@contoh.id\",\n  \"password\": \"Rahasia123\",\n  \"consent\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST login (OTP_REQUIRED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"taruna@contoh.id\",\n  \"password\": \"Rahasia123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "POST 2fa verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"PASTE_CHALLENGE_ID\",\n  \"code\": \"PASTE_OTP_6_DIGIT\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/2fa/verify"
          }
        },
        {
          "name": "POST 2fa resend",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"PASTE_CHALLENGE_ID\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/2fa/resend"
          }
        },
        {
          "name": "POST refresh (cookie)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh" }
        },
        {
          "name": "POST logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "POST password forgot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"taruna@contoh.id\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/password/forgot"
          }
        },
        {
          "name": "POST password reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_RESET_TOKEN\",\n  \"newPassword\": \"Baru1234\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/password/reset"
          }
        },
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "20-admin-users",
      "item": [
        {
          "name": "GET list users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users?page=1&pageSize=20"
          }
        },
        {
          "name": "GET user detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users/:userId"
          }
        },
        {
          "name": "POST create non-Taruna (Superadmin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mentor@contoh.id\",\n  \"password\": \"Rahasia123\",\n  \"role\": \"MENTOR\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/users"
          }
        },
        {
          "name": "POST verify Taruna",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"verified\": true\n}" },
            "url": "{{baseUrl}}/api/v1/admin/users/:userId/verify"
          }
        },
        {
          "name": "PATCH user status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SUSPENDED\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/users/:userId/status"
          }
        },
        {
          "name": "PATCH user role (Superadmin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"ADMIN\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/users/:userId/role"
          }
        },
        {
          "name": "GET download template xlsx",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users/imports/template"
          }
        },
        {
          "name": "POST import xlsx",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "impor-taruna.xlsx" }] },
            "url": "{{baseUrl}}/api/v1/admin/users/import"
          }
        },
        {
          "name": "GET download error log xlsx",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users/imports/:importId/errors"
          }
        }
      ]
    },
    {
      "name": "30-cohorts-enrollments",
      "item": [
        {
          "name": "GET cohorts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/cohorts"
          }
        },
        {
          "name": "POST cohort",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"ANGK-2026-01\",\n  \"name\": \"Angkatan 2026-01\"\n}" },
            "url": "{{baseUrl}}/api/v1/cohorts"
          }
        },
        {
          "name": "GET cohort enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/cohorts/:cohortId/enrollments"
          }
        },
        {
          "name": "POST enroll Taruna",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"PASTE_TARUNA_ID\"\n}" },
            "url": "{{baseUrl}}/api/v1/cohorts/:cohortId/enrollments"
          }
        },
        {
          "name": "GET my enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/me/enrollments"
          }
        }
      ]
    }
  ]
}

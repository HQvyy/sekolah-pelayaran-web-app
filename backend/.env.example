# Placeholder saja — JANGAN commit secret/nilai nyata.
# Salin ke .env lalu isi per environment (dev/staging/production terpisah).

# Umum
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=log

# PostgreSQL (wajib di staging/production; boleh kosong di dev/test tanpa DB —
# /ready akan melaporkan database: not-configured)
DATABASE_URL=postgresql://user:password@localhost:5432/spli?schema=public

# CORS: daftar origin dipisah koma. Kosong = tolak semua (kecuali non-browser).
CORS_ORIGINS=http://localhost:5173

# Swagger/OpenAPI (docs + docs-json di-exclude dari prefix API)
SWAGGER_ENABLED=true

# Rate limit global default (limit per ttl per IP)
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_MS=60000

# Aturan CBT default — KONFIGURASI SEMENTARA, menunggu konfirmasi klien.
# Bukan konstanta final; perubahan nilai tidak mengubah kontrak API.
PASSING_GRADE=70
MAX_ATTEMPTS=3
ATTEMPT_COOLDOWN_HOURS=24
REMEDIAL_AFTER_FAILURES=3

# Email (interface sejak Tahap 2; fake = tanpa pengiriman nyata, untuk dev/test)
EMAIL_PROVIDER=fake
EMAIL_FROM=
# SMTP_* hanya diisi bila EMAIL_PROVIDER=smtp via secret manager/CI variables
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# JWT: secret penandatangan access token. WAJIB diisi (min 32 karakter),
# berbeda per environment, via secret manager/CI variables di staging/prod.
# JANGAN commit nilai nyata. Contoh generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Bunny Stream (integrasi video, Tahap 4).
# - BUNNY_USE_FAKE=true (default): memakai FakeBunnyProvider untuk dev/test.
#   Token playback berprefix FAKE- — JELAS bukan token sungguhan.
# - Produksi: set BUNNY_USE_FAKE=false + isi kredensial via secret manager/CI
#   variables. Tanpa kredensial, endpoint integrasi gagal aman 503.
# JANGAN commit nilai nyata. Secret tidak pernah dikirim ke frontend/log.
BUNNY_USE_FAKE=true
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# Konferensi Live Lesson (Jitsi Meet — termurah/gratis + embed, Tahap 5).
# - CONFERENCE_USE_FAKE=true (default): FakeConferenceProvider untuk dev/test.
# - Produksi Jitsi publik: set CONFERENCE_USE_FAKE=false; JITSI_DOMAIN opsional
#   (default https://meet.jit.si). Tanpa kredensial tetap jalan (ruang publik).
# - Zoom/Meet berbayar disuntik belakangan bila PKS mengharuskan (Change Request).
CONFERENCE_USE_FAKE=true
JITSI_DOMAIN=
